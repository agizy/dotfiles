{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "C:/Users/Panaino/.config/fastfetch/gh0stzk-logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "cyan",
      "2": "blue"
    }
  },
  "display": {
    "separator": "  ─  ",
    "color": {
      "keys": "cyan",
      "title": "blue"
    },
    "brightColor": false
  },
  "modules": [
    "break",
    "title",
    "separator",
    {
      "type": "os",
      "key": "   os",
      "format": "{name} {version}"
    },
    {
      "type": "host",
      "key": "  󰌢 host"
    },
    {
      "type": "kernel",
      "key": "  󰌽 ker"
    },
    {
      "type": "packages",
      "key": "  󰏗 pkgs"
    },
    {
      "type": "shell",
      "key": "  󰞷 sh"
    },
    {
      "type": "terminal",
      "key": "   term"
    },
    {
      "type": "de",
      "key": "  󰧨 de"
    },
    {
      "type": "wm",
      "key": "  󰖲 wm"
    },
    {
      "type": "memory",
      "key": "  󰍛 ram",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "  󰋊 disk",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "uptime",
      "key": "  󰔟 up"
    },
    {
      "type": "cpu",
      "key": "   cpu",
      "format": "{name}"
    },
    {
      "type": "gpu",
      "key": "  󰍹 gpu",
      "format": "{name}"
    },
    "break",
    "colors"
  ]
}
